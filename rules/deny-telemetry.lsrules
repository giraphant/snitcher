{
  "name": "Snitcher — Block Optional Telemetry and Probes",
  "description": "Optional telemetry, feature-flag and IP lookup hosts plus observed one-off diagnostic probes for Rex, Claude Code, Codex and Orca. Disable an individual rule or this group for deliberate diagnostics.",
  "rules": [
    {
      "process": "identifier.AG92C3PT77/com.superlogical.rex.server",
      "action": "deny",
      "direction": "outgoing",
      "disabled": false,
      "priority": "high",
      "notes": "可选遥测、使用统计、特性开关与公网 IP 查询：Claude Datadog、Homebrew 统计、Codex Statsig、agy Clearcut/Unleash、Tailscale 日志、ipinfo。",
      "remote-hosts": [
        "http-intake.logs.us5.datadoghq.com",
        "browser-intake-us5-datadoghq.com",
        "analytics.brew.sh",
        "ab.chatgpt.com",
        "play.googleapis.com",
        "antigravity-unleash.goog",
        "log.tailscale.com",
        "ipinfo.io"
      ]
    },
    {
      "process": "identifier.AG92C3PT77/com.superlogical.rex.server",
      "action": "deny",
      "direction": "outgoing",
      "disabled": false,
      "priority": "high",
      "notes": "历史中的一次性 ICMP 网络测速。",
      "remote-hosts": [
        "sgp-ping.vultr.com",
        "lon-gb-ping.vultr.com",
        "speedtest.singapore.linode.com",
        "speedtest.london.linode.com"
      ],
      "protocol": "icmp"
    },
    {
      "process": "identifier.AG92C3PT77/com.superlogical.rex.server",
      "action": "deny",
      "direction": "outgoing",
      "disabled": false,
      "priority": "high",
      "notes": "历史中的 TCP 80 HTTP 连通性探测；不影响这些主机的 HTTPS。",
      "remote-hosts": [
        "dynamodb.ap-southeast-1.amazonaws.com",
        "dynamodb.ap-northeast-1.amazonaws.com"
      ],
      "protocol": "tcp",
      "ports": "80"
    },
