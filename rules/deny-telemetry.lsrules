{
  "name": "Snitcher — Block Optional Telemetry and Probes",
  "description": "Optional telemetry, feature-flag and IP lookup hosts, non-essential agy fetches (avatar, plugin catalog, update check) and observed one-off diagnostic probes for Rex, Claude Code, Codex and Orca. Standalone agy and Vibe Island are also covered for their telemetry and non-essential fetches. Disable an individual rule or this group for deliberate diagnostics.",
  "rules": [
    {
      "process": "identifier.AG92C3PT77/com.superlogical.rex.server",
      "action": "deny",
      "direction": "outgoing",
      "disabled": false,
      "priority": "high",
      "notes": "可选遥测、使用统计、特性开关与公网 IP 查询：Claude Datadog、Homebrew 统计、Codex Statsig、agy Clearcut/Unleash、Tailscale 日志、ipinfo。",
      "remote-hosts": [
        "http-intake.logs.us5.datadoghq.com",
        "browser-intake-us5-datadoghq.com",
        "analytics.brew.sh",
        "ab.chatgpt.com",
        "play.googleapis.com",
        "antigravity-unleash.goog",
        "log.tailscale.com",
        "ipinfo.io"
      ]
    },
    {
      "process": "identifier.AG92C3PT77/com.superlogical.rex.server",
      "action": "deny",
      "direction": "outgoing",
      "disabled": false,
      "priority": "high",
      "notes": "历史中的一次性 ICMP 网络测速。",
      "remote-hosts": [
        "sgp-ping.vultr.com",
        "lon-gb-ping.vultr.com",
        "speedtest.singapore.linode.com",
        "speedtest.london.linode.com"
      ],
      "protocol": "icmp"
